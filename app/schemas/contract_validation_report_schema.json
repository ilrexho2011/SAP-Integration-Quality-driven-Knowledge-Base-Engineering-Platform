{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QDKEP Contract Validation Report v1.1",
  "type": "object",
  "required": ["package_path", "contract_version", "generated_at", "status", "promotion_decision", "artifact_count", "checked_files", "issues", "contract_sources"],
  "properties": {
    "package_path": {"type": "string"},
    "contract_version": {"const": "QDKEP_AI4BIZ_OUTPUT_CONTRACT_v1.1"},
    "generated_at": {"type": "string"},
    "status": {"enum": ["approved", "needs_remediation"]},
    "promotion_decision": {"enum": ["approved_for_ai4biz_ingestion", "blocked"]},
    "artifact_count": {"type": "integer", "minimum": 0},
    "checked_files": {"type": "array", "items": {"type": "string"}},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "category", "severity", "message", "recommendation"],
        "properties": {
          "artifact": {"type": "string"},
          "category": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "message": {"type": "string"},
          "recommendation": {"type": "string"}
        }
      }
    },
    "contract_sources": {
      "type": "object",
      "required": ["en", "sq"],
      "properties": {"en": {"type": "string"}, "sq": {"type": "string"}}
    }
  }
}
