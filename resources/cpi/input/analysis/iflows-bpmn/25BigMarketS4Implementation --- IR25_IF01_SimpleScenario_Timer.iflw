                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;order&gt;
    &lt;orderId&gt;567890&lt;/orderId&gt;
    &lt;customer&gt;
        &lt;id&gt;789&lt;/id&gt;
        &lt;name&gt;Mein Beispiel&lt;/name&gt;
        &lt;email&gt;mein.beispiel@example.com&lt;/email&gt;
    &lt;/customer&gt;
    &lt;items&gt;
        &lt;item&gt;
            &lt;productId&gt;3001&lt;/productId&gt;
            &lt;name&gt;4K Monitor 27 Zoll&lt;/name&gt;
            &lt;quantity&gt;2&lt;/quantity&gt;
            &lt;price&gt;399.99&lt;/price&gt;
        &lt;/item&gt;
        &lt;item&gt;
            &lt;productId&gt;3002&lt;/productId&gt;
            &lt;name&gt;Ergonomischer Bürostuhl&lt;/name&gt;
            &lt;quantity&gt;1&lt;/quantity&gt;
            &lt;price&gt;249.99&lt;/price&gt;
        &lt;/item&gt;
    &lt;/items&gt;
    &lt;totalAmount&gt;1049.97&lt;/totalAmount&gt;
    &lt;status&gt;Processing&lt;/status&gt;
&lt;/order&gt;</value>
                </ifl:property>
