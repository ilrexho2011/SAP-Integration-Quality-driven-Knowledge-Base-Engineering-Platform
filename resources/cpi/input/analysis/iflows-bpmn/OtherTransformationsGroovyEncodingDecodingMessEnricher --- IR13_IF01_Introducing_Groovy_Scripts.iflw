            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="CallActivity_26" id="BPMNShape_CallActivity_26">
                <dc:Bounds height="60.0" width="100.0" x="522.0" y="110.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_5" id="BPMNEdge_SequenceFlow_5" sourceElement="BPMNShape_CallActivity_4" targetElement="BPMNShape_CallActivity_26">
                <di:waypoint x="462.0" xsi:type="dc:Point" y="140.0"/>
                <di:waypoint x="522.0" xsi:type="dc:Point" y="140.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_3" id="BPMNEdge_SequenceFlow_3" sourceElement="BPMNShape_StartEvent_2" targetElement="BPMNShape_CallActivity_4">
                <di:waypoint x="302.0" xsi:type="dc:Point" y="140.0"/>
                <di:waypoint x="362.0" xsi:type="dc:Point" y="140.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="MessageFlow_25" id="BPMNEdge_MessageFlow_25" sourceElement="BPMNShape_Participant_1" targetElement="BPMNShape_StartEvent_2">
                <di:waypoint x="100.0" xsi:type="dc:Point" y="140.0"/>
                <di:waypoint x="286.0" xsi:type="dc:Point" y="140.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="SequenceFlow_27" id="BPMNEdge_SequenceFlow_27" sourceElement="BPMNShape_CallActivity_26" targetElement="BPMNShape_EndEvent_2">
                <di:waypoint x="622.0" xsi:type="dc:Point" y="140.0"/>
                <di:waypoint x="682.0" xsi:type="dc:Point" y="140.0"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
