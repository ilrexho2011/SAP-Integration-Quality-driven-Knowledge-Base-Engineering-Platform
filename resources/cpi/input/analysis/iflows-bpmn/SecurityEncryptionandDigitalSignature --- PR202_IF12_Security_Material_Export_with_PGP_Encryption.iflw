                    <value>com.sap.it.ide.mail.ui.namespace2</value>
                </ifl:property>
                <ifl:property>
                    <key>keep_attachments</key>
                    <value>1</value>
                </ifl:property>
                <ifl:property>
                    <key>body</key>
                    <value>&lt;html&gt;
&lt;body style="font-family: Times New Roman, Times New Roman; color: #000000; background-color: #f4f4f4; padding: 20px; margin: 0;"&gt;

 &lt;div style="background-color: #ffffff; border-radius: 8px; padding: 20px; box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);"&gt;
 
 &lt;!-- Header --&gt;
 &lt;h2 style="color: #007BFF; margin-top: 0;"&gt;Secure Credentials Attached&lt;/h2&gt;
 
 &lt;!-- Greeting and Introduction --&gt;
 &lt;p&gt;Hello,&lt;/p&gt;
 &lt;p&gt;
 Please find attached &lt;strong&gt;file&lt;/strong&gt; containing access credentials with &lt;strong&gt;PGP Encryption&lt;/Strong&gt;. 
 This information is strictly &lt;span style="color: #D32F2F; font-weight: bold;"&gt;confidential&lt;/span&gt; and should be handled with care.
 &lt;/p&gt;
 
 &lt;!-- Important Note for Password Sharing --&gt;
 &lt;div style="background-color: #ffebcc; padding: 10px; margin: 10px 0; border-left: 4px solid #FF9800;"&gt;
 &lt;p style="margin: 0; font-weight: bold;"&gt;Important:&lt;/p&gt;
 &lt;p style="margin: 5px 0 0 0;"&gt;PGP Secret key and passphrase required to decrypt the attached file.&lt;/p&gt;
 &lt;/div&gt;
 
 &lt;!-- Security Guidelines Section --&gt;
 &lt;div style="background-color: #f8f9fa; padding: 10px; margin: 10px 0; border-left: 4px solid #007BFF;"&gt;
 &lt;p style="margin: 0; font-weight: bold;"&gt;Security Guidelines:&lt;/p&gt;
 &lt;ul style="margin: 5px 0 0 20px; padding: 0;"&gt;
 &lt;li&gt;
 &lt;strong&gt;Sensitive Information:&lt;/strong&gt; The attached file contains credentials retrieved from 
 &lt;strong&gt;SAP CPI Security Material&lt;/strong&gt;. Please ensure it is stored securely.
 &lt;/li&gt;
 &lt;li&gt;
 &lt;strong&gt;Restricted Access:&lt;/strong&gt; Only authorized personnel should access and use this information.
 &lt;/li&gt;
 &lt;li&gt;
 &lt;strong&gt;Secure Storage:&lt;/strong&gt; Do not store this file in unsecured locations or forward it via unsecured channels.
 &lt;/li&gt;
 &lt;/ul&gt;
 &lt;/div&gt;
 
 &lt;!-- Confidentiality Notice --&gt;
 &lt;p style="color: #D32F2F; font-weight: bold;"&gt;Confidentiality Notice:&lt;/p&gt;
 &lt;p&gt;
 This email and its attachment contain &lt;strong&gt;sensitive security details&lt;/strong&gt;. 
 If you are not the intended recipient, please &lt;strong&gt;delete this message immediately&lt;/strong&gt; and notify the sender. 
 Unauthorized access, sharing, or storage of this information is strictly prohibited.
 &lt;/p&gt;
 
 &lt;!-- Closing and Signature --&gt;
 &lt;p&gt;For any issues or further assistance, please contact SAP CPI Team.&lt;/p&gt;
 &lt;p&gt;
 &lt;strong&gt;Best regards,&lt;/strong&gt;&lt;br&gt;
 SAP CPI Team&lt;br&gt;
 &lt;/p&gt;
 
 &lt;!-- Footer --&gt;
 &lt;p style="font-size: 12px; color: #777; margin-top: 20px;"&gt;
 This is an automated email from SAP CPI. Do not reply.
 &lt;/p&gt;
 
 &lt;/div&gt;

&lt;/body&gt;
&lt;/html&gt;</value>
