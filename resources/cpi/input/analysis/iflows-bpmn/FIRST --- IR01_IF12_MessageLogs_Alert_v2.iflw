                    <ifl:property>
                        <key>cmdVariantUri</key>
                        <value>ctype::FlowstepVariant/cname::intermediatetimer/version::1.4.0</value>
                    </ifl:property>
                    <ifl:property>
                        <key>activityType</key>
                        <value>StartTimerEvent</value>
                    </ifl:property>
                </bpmn2:extensionElements>
            </bpmn2:timerEventDefinition>
        </bpmn2:startEvent>
