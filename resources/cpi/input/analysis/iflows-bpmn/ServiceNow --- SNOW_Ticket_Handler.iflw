		&lt;priority&gt;${property.Priority}&lt;/priority&gt;
		&lt;work_notes&gt;${property.Work_Notes}&lt;/work_notes&gt;
		&lt;u_guest_full_name&gt;SAP CPI Auto Ticket&lt;/u_guest_full_name&gt;
	&lt;/entry&gt;
&lt;/request&gt;</value>
                </ifl:property>
