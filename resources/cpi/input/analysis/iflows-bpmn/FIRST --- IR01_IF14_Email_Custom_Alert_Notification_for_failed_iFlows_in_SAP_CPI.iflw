                    <value>CREATE TABLE FAILED_IFLOWS_${header.dbname}(
ID INTEGER,
IType VARCHAR(256),
IName VARCHAR(256),
PackageId VARCHAR(256),
LogStart VARCHAR(256).
LogEnd VARCHAR(256).
OriginComponentName VARCHAR(256).
PreviousComponentName VARCHAR(256).
LocalComponentName VARCHAR(256).
MessageGuid VARCHAR(256).
AlternateWebLink VARCHAR(256).
LogLevel VARCHAR(256).
TransactionId VARCHAR(256).
CorrelationId VARCHAR(256).
PRIMARY KEY (ID)
)</value>
